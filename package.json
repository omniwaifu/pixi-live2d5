{
    "name": "pixi-live2d5",
    "version": "v0.5.0-beta",
    "description": "Cubism 5 Live2D integration for PixiJS 8",
    "main": "dist/index.js",
    "type": "module",
    "packageManager": "bun@1.3.14",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "import": "./dist/index.es.js",
            "require": "./dist/index.js"
        },
        "./cubism5": {
            "types": "./types/index.d.ts",
            "import": "./dist/cubism5.es.js",
            "require": "./dist/cubism5.js"
        },
        "./extra": {
            "types": "./types/extra.d.ts",
            "import": "./dist/extra.es.js",
            "require": "./dist/extra.js"
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/omniwaifu/pixi-live2d5.git"
    },
    "homepage": "https://github.com/omniwaifu/pixi-live2d5#readme",
    "bugs": {
        "url": "https://github.com/omniwaifu/pixi-live2d5/issues"
    },
    "author": "Justin <9146678+brickfrog@users.noreply.github.com>",
    "contributors": [
        "guansss <821143943@qq.com> (original pixi-live2d-display project)"
    ],
    "license": "MIT",
    "scripts": {
        "setup": "node scripts/setup.js",
        "playground": "vite",
        "prepare": "bun run type && bun run build",
        "clean": "rimraf dist types",
        "test": "bun run test:node && bun run test:browser",
        "test:browser": "vitest run",
        "test:node": "vitest run --config vitest.node.config.ts",
        "test:u": "vitest --update",
        "build": "rimraf dist && node scripts/build.js",
        "type": "rimraf types && dts-bundle-generator src/index.ts --no-check --project=tsconfig.docs.json -o=types/index.d.ts && dts-bundle-generator src/extra.ts --no-check --project=tsconfig.docs.json -o=types/extra.d.ts",
        "posttype": "node scripts/patch-types.js",
        "typecheck": "tsc --noEmit --project tsconfig.build.json",
        "typecheck:declarations": "tsc --noEmit --incremental false --skipLibCheck false --moduleResolution bundler --module esnext --target esnext --lib esnext,dom types/index.d.ts types/extra.d.ts",
        "doc": "node scripts/gen-docs.js",
        "serve-docs": "mkdocs serve -f docs/mkdocs.yml",
        "deploy": "gh-pages -d site",
        "prepublishOnly": "bun run lint && bun run type && bun run build && bun run test",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "validate": "bun run typecheck && bun run lint && bun run type && bun run typecheck:declarations && bun run build && bun run test"
    },
    "files": [
        "dist",
        "types"
    ],
    "types": "types/index.d.ts",
    "peerDependencies": {
        "pixi.js": "^8.19.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.13.3",
        "@vitest/browser": "^4.1.10",
        "@vitest/browser-playwright": "4.1.10",
        "dts-bundle-generator": "9.5.1",
        "eslint": "^10.0.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "gh-pages": "^6.3.0",
        "globals": "^17.7.0",
        "handlebars": "^4.7.9",
        "jszip": "^3.10.1",
        "pixi.js": "^8.19.0",
        "playwright": "1.61.1",
        "prettier": "^3.9.5",
        "rimraf": "^6.1.3",
        "terser": "^5.49.0",
        "typedoc": "0.28.20",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.64.0",
        "vite": "6.4.3",
        "vitest": "^4.1.10"
    }
}
