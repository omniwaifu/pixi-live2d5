{
    "compilerOptions": {
        "experimentalDecorators": true,
        "declaration": true,
        "incremental": true,
        "target": "esnext",
        "module": "esnext",
        "strict": true,
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "noUncheckedIndexedAccess": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "sourceMap": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"],
            "@cubism/*": ["cubism/src/*"]
        },
        "types": ["node", "@vitest/browser-playwright"],
        "lib": ["esnext", "dom", "dom.iterable"]
    },
    "include": [
        "core/**/*.d.ts",
        "playground/**/*.ts",
        "src/**/*.ts",
        "test/**/*.ts",
        "vite.config.ts",
        "vitest.node.config.ts"
    ],
    "exclude": ["cubism", "dist", "node_modules", "site", "test.build", "types"]
}
